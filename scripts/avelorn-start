#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
AVELORN_ROOT=$(dirname -- "$SCRIPT_DIR")
RUN_DIR=${AVELORN_RUN_DIR:-"$HOME/.jvmud/avelorn"}
CLASSPATH_FILE="$AVELORN_ROOT/target/jvmud-runtime-classpath.txt"

cd "$AVELORN_ROOT"
if ! mvn -q dependency:build-classpath -DincludeScope=runtime -Dmdep.outputFile="$CLASSPATH_FILE"; then
  printf '%s\n' "Run scripts/avelorn-install-jvmud to install the pinned JVMud build." >&2
  exit 1
fi

mkdir -p "$RUN_DIR"
cd "$RUN_DIR"
exec java -cp "$(cat "$CLASSPATH_FILE")" io.github.protasm.jvmud.engine.application.JVMud \
  "$AVELORN_ROOT/jvmud/avelorn.config" "$@"
