#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
AVELORN_ROOT=$(dirname -- "$SCRIPT_DIR")
JVMUD_ROOT=${JVMUD_ROOT:-"$(dirname -- "$AVELORN_ROOT")/jvmud"}

if [ ! -x "$JVMUD_ROOT/scripts/jvmud-start" ]; then
  echo "JVMud was not found at $JVMUD_ROOT" >&2
  echo "Set JVMUD_ROOT to the JVMud checkout." >&2
  exit 1
fi

cd "$AVELORN_ROOT"
exec "$JVMUD_ROOT/scripts/jvmud-start" "$AVELORN_ROOT/jvmud/avelorn.config" "$@"
