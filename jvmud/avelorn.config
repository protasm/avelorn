# Native JVMud mudlib configuration for Avelorn.

game_id = avelorn
game_name = Avelorn
engine_capabilities = mudlib_files, session_control
mudlib_root = ../source
mudlib_object = jvmud/mudlib

mfun_object = system/presentation
persona_object = persona/adventurer
player_prompt = >
presentation.connected_banner = Welcome to Avelorn.
transport.control_prefix = //
max_line_length = 140
show_ruler = false

initial_place = place/atlas/x2080/y3936
preload_objects = system/presentation, system/pronouns, system/economy, system/items, system/quests, system/socials, system/gmcp, system/atlas

lifecycle.object_loaded = initialize
lifecycle.object_source_missing = compile_atlas_room
lifecycle.interaction_scope_started = offer_interactions
lifecycle.player_session_connected = begin_session
lifecycle.player_session_disconnected = end_session

temporal_tick_method = scheduled_update
temporal_tick_interval = 1
