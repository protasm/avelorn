# Native JVMud mudlib configuration for Avelorn: The Lantern Crown.

game_id = avelorn
game_name = Avelorn: The Lantern Crown
engine_capabilities = mudlib_files, session_control
mudlib_root = ../source

persona_object = persona/adventurer
player_prompt = >
presentation.connected_banner = Welcome to Avelorn: The Lantern Crown.
transport.control_prefix = //
max_line_length = 80
show_ruler = false

initial_place = place/brindleford/village_green
preload_objects = system/pronouns, system/economy, system/items, place/brindleford/village_green, place/brindleford/lantern_house, place/brindleford/market, place/brindleford/reeves_hall, place/brindleford/shrine, place/brindleford/mill_road, place/brindleford/east_road, place/brindleford/old_bridge, place/brindleford/mill_yard, place/brindleford/cellar_landing, place/brindleford/pump_room, place/brindleford/grain_cellar

lifecycle.object_loaded = initialize
lifecycle.interaction_scope_started = offer_interactions
lifecycle.player_session_connected = begin_session
lifecycle.player_session_disconnected = end_session
