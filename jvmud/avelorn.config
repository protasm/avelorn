# Native JVMud mudlib configuration for Avelorn: The Lantern Crown.

game_id = avelorn
game_name = Avelorn: The Lantern Crown
engine_capabilities = mudlib_files, session_control
mudlib_root = ../source

persona_object = persona/adventurer
player_prompt = >
presentation.connected_banner = Welcome to Avelorn: The Lantern Crown.
transport.control_prefix = //
max_line_length = 80
show_ruler = false

initial_place = place/brindleford/village_green
preload_objects = system/pronouns, system/economy, system/items, system/quests, place/brindleford/village_green, place/brindleford/lantern_house, place/brindleford/market, place/brindleford/reeves_hall, place/brindleford/shrine, place/brindleford/mill_road, place/brindleford/east_road, place/brindleford/old_bridge, place/brindleford/mill_yard, place/brindleford/cellar_landing, place/brindleford/pump_room, place/brindleford/grain_cellar, place/lantern_road/toll_meadow, place/lantern_road/royal_waystone, place/lantern_road/riverside_path, place/lantern_road/crown_shelter, place/lantern_road/orchard_lane, place/lantern_road/birch_copse, place/lantern_road/lamplighter_post, place/lantern_road/westward_rise, place/lantern_road/greyhaven_approach, place/greyhaven/west_gate, place/greyhaven/gate_square, place/greyhaven/market_cross, place/greyhaven/heron_fountain, place/greyhaven/temple_court, place/greyhaven/lantern_tower, place/greyhaven/archive_court, place/greyhaven/company_hall, place/greyhaven/smith_lane, place/greyhaven/guild_row, place/greyhaven/river_quay, place/greyhaven/watch_barracks, place/greyhaven/north_gate, place/north_road/patrol_crossing, place/north_road/shepherd_fields, place/north_road/abandoned_post, place/north_road/merewatch_road

lifecycle.object_loaded = initialize
lifecycle.interaction_scope_started = offer_interactions
lifecycle.player_session_connected = begin_session
lifecycle.player_session_disconnected = end_session

temporal_tick_method = scheduled_update
temporal_tick_interval = 1
